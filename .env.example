# ============================== Model & Device ==============================
MODEL_PATH=models/yolo26m.pt
SLOTS_PATH=parking_slots.json
# cuda, cuda:0, atau cpu. Default: cuda (fallback CPU jika ALLOW_CPU_FALLBACK=true).
DEVICE=cuda
ALLOW_CPU_FALLBACK=true
# Ukuran letterbox inference YOLO (naikkan untuk mobil kecil/jauh).
YOLO_IMGSZ=1280

# ================================ Detection ================================
# Ambang Intersection over Area kendaraan vs polygon slot.
OCCUPANCY_IOA_THRESHOLD=0.30

# Temporal anti-flicker: jumlah frame konsisten sebelum status berubah.
SLOT_STATE_FRAMES=5
# Opsional: override terpisah untuk transisi terisi/kosong.
# SLOT_OCCUPIED_FRAMES=5
# SLOT_EMPTY_FRAMES=5

# Opsional: normalisasi perspektif top-down (4 titik: x1,y1,...,x4,y4).
# PARKING_PERSPECTIVE=100,900,1820,900,1500,300,420,300

# ================================== API ====================================
# Kosongkan untuk menonaktifkan autentikasi (khusus development).
# Jika diisi, semua endpoint /api/v1/* wajib header: X-API-Key.
API_KEY=change-me
# Daftar origin CORS yang diizinkan (pisahkan koma, atau * untuk semua).
CORS_ORIGINS=*


# ================================ Webhook ==================================
# URL endpoint backend Go yang menerima event slot_state_changed.
# Kosongkan untuk menonaktifkan webhook.
WEBHOOK_URL=
# Opsional. Jika kosong, dispatcher memakai API_KEY.
WEBHOOK_API_KEY=
WEBHOOK_TIMEOUT=5
WEBHOOK_RETRIES=3

# =============================== Test Video ================================
TEST_VIDEO_DIR=test_videos
DEFAULT_VIDEO=video1.mp4
